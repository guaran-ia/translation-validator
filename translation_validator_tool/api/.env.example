# Required: PostgreSQL connection. Replace these sample credentials.
# Also used by migrations, maintenance scripts and metrics.
# Exported environment variables take precedence over api/.env.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/translation_validator

# Required: replace SECRET_KEY with a random value before using the API.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed frontend origins as a JSON array (scheme, hostname and port).
# Add the frontend origin of your deployment here.
CORS_ORIGINS=["http://localhost:5173"]

# App
PROJECT_NAME=Translation Validator
VERSION=1.0.0

# Legacy Prodigy configuration (not required by the current translation UI)
PRODIGY_HOST=localhost
PRODIGY_PORT=8082

# Optional SMTP settings for admin notifications on new registrations
# Add these when you want the backend to send emails to admins on new user registration.
# Examples below show common providers — DO NOT commit real credentials to git.
#
# Gmail (use an App Password; enable "Less secure apps" is deprecated):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youremail@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM="Translation Validator <noreply@yourdomain.com>"
# SMTP_USE_TLS=true
#
# Mailgun (use the SMTP credentials for your domain):
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-mailgun-domain
# SMTP_PASSWORD=your-mailgun-password
# SMTP_FROM="Translation Validator <noreply@yourdomain.com>"
# SMTP_USE_TLS=true
#
# SendGrid (SMTP using API key):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_FROM="Translation Validator <noreply@yourdomain.com>"
# SMTP_USE_TLS=true
#
# Local development options:
# - MailHog (common dev tool): host=localhost port=1025, no auth, TLS=false
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_FROM="Translation Validator <noreply@localhost>"
#   SMTP_USE_TLS=false
# - smtp4dev: similar settings depending on your local setup.
