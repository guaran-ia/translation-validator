```bash
# Backend API URL
VITE_API_URL=http://localhost:8000/api

# Prodigy Proxy URL (puerto del proxy seguro)
VITE_PRODIGY_PROXY_URL=http://localhost:8085

# Puertos directos de Prodigy (sin proxy, para acceso local)
VITE_PRODIGY_POS_PORT=8080
VITE_PRODIGY_FEATURES_PORT=8081
VITE_PRODIGY_RELATIONS_PORT=8082

# Tooltip texts for Guaraní classification (optional). If unset, sensible defaults are used.
# Guaraní puro
VITE_TOOLTIP_GUARANI_PURO_TITLE=Guaraní puro (o académico)
VITE_TOOLTIP_GUARANI_PURO_DESC=Forma tradicional y académica del guaraní. Se utiliza en contextos formales y educativos.
VITE_TOOLTIP_GUARANI_PURO_EXAMPLE=

# Jopara
VITE_TOOLTIP_JOPARA_TITLE=Jopara
VITE_TOOLTIP_JOPARA_DESC=Mezcla o préstamo léxico entre guaraní y español; combina palabras y estructuras de ambas lenguas.
VITE_TOOLTIP_JOPARA_EXAMPLE=Ejemplo: "venina na" (venina = español, na = guaraní)

# Jehe'a
VITE_TOOLTIP_JEHEA_TITLE=Jehe'a (Guaraní paraguayo)
VITE_TOOLTIP_JEHEA_DESC=Variante más cotidiana del guaraní en Paraguay; puede incluir rasgos de hibridación con el español.
VITE_TOOLTIP_JEHEA_EXAMPLE=
```