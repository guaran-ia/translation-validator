# =============================================================================
# CONFIGURACIÓN PRODIGY - Proyecto Guaraní
# =============================================================================
# Copia este archivo como .env y completa los valores

# =============================================================================
# 🤖 OpenAI Configuration
# =============================================================================
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...tu-clave-aqui...

# Opciones: gpt-4o-mini (barato), gpt-4o (mejor), gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# 0 = determinístico, 1 = creativo
OPENAI_TEMPERATURE=0.1

# =============================================================================
# 🔗 Backend y Puertos
# =============================================================================
BACKEND_URL=http://localhost:8000
PRODIGY_PORT=8080
PRODIGY_PROXY_PORT=8082

# =============================================================================
# 👥 Usuarios por Tipo de Anotación
# =============================================================================
# Todas las sesiones permitidas
PRODIGY_ALLOWED_SESSIONS="alice,bob,carlos,diana,elena,marcos,nicolas"

# POS Tagging
VALIDATORS_POS="alice,bob"

# Features morfológicas
VALIDATORS_FEATURES="carlos,elena"

# Relaciones sintácticas
VALIDATORS_RELATIONS="marcos,nicolas"

# =============================================================================
# 🔀 Task Router (Inter-Annotator Agreement)
# =============================================================================
# Cuántos anotadores ven cada tarea (2-3 recomendado para IAA)
ANNOTATIONS_PER_TASK=3
ENABLE_TASK_ROUTING=true

# =============================================================================
# 🔄 Batch Auto-Advance
# =============================================================================
# Intervalo de chequeo (segundos)
BATCH_MONITOR_INTERVAL=60

# Oraciones por batch
SENTENCES_PER_BATCH=50

# URL del Prodigy Manager
PRODIGY_MANAGER_URL=http://localhost:8085
