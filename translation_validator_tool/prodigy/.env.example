# Configuración OpenAI para Prodigy
# Copia este archivo como .env y completa tu API key

# 🔑 API Key de OpenAI (obligatorio)
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...tu-clave-aqui...

# 🤖 Modelo a usar (opcional, default: gpt-3.5-turbo)
# Opciones: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview
OPENAI_MODEL=gpt-3.5-turbo

# 🌡️ Temperature (opcional, default: 0)
# 0 = más determinístico, 1 = más creativo
OPENAI_TEMPERATURE=0

# 💾 Base de datos Prodigy
PRODIGY_DB=sqlite

# 🔢 Puerto del servidor
PRODIGY_PORT=8081
PRODIGY_PROXY_PORT=8082

# � Backend URL (para validación de tokens)
BACKEND_URL=http://localhost:8000

# 🔀 Task Router Configuration (para Inter-Annotator Agreement)
# Cuántos anotadores deben ver cada tarea
# 1 = sin overlap (cada tarea la ve 1 persona)
# 2 = cada tarea la ven 2 personas (recomendado para IAA)
# 3+ = más overlap para datasets importantes
ANNOTATIONS_PER_TASK=2

# Habilitar/deshabilitar task routing (true/false)
ENABLE_TASK_ROUTING=true

# 💾 Auto-guardado Configuration
# Cada cuántas anotaciones guardar automáticamente en la base de datos
# 1 = guardar después de cada anotación (más seguro, un poco más lento)
# 3 = guardar cada 3 anotaciones (balance recomendado)
# 5 = guardar cada 5 anotaciones (más rápido, menos seguro)
AUTO_SAVE_EVERY=1

# Sesiones de anotadores permitidas (todas)
PRODIGY_ALLOWED_SESSIONS="alice,bob,carlos,diana,elena,marcos,nicolas"

# =============================================================================
# 👥 USUARIOS POR TIPO DE ANOTACIÓN
# =============================================================================
# Define qué usuarios pueden hacer cada tipo de validación
# Los usuarios se separan por comas

# POS Tagging - Etiquetado de partes del discurso
VALIDATORS_POS="alice,bob"

# Features - Características morfológicas
VALIDATORS_FEATURES="carlos,elena"

# Relations - Relaciones sintácticas
VALIDATORS_RELATIONS="marcos,nicolas"

# =============================================================================
# 🔄 BATCH AUTO-ADVANCE CONFIGURATION
# =============================================================================
# Sistema de auto-avance de batches

# Intervalo de chequeo del monitor (segundos)
# Cada cuánto tiempo verificar si todos completaron el batch
BATCH_MONITOR_INTERVAL=60

# Número de validadores requeridos para considerar un batch completo
# Cuando N validadores completen sus 50 frases, se avanza al siguiente batch
REQUIRED_VALIDATORS=3

# Oraciones por batch
SENTENCES_PER_BATCH=50

# Total de batches disponibles (3000 oraciones / 50 = 60 batches)
TOTAL_BATCHES=60

# URL del Prodigy Manager (para el batch monitor)
PRODIGY_MANAGER_URL=http://localhost:8085
