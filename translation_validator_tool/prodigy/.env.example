# Configuración OpenAI para Prodigy
# Copia este archivo como .env y completa tu API key

# 🔑 API Key de OpenAI (obligatorio)
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...tu-clave-aqui...

# 🤖 Modelo a usar (opcional, default: gpt-3.5-turbo)
# Opciones: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview
OPENAI_MODEL=gpt-3.5-turbo

# 🌡️ Temperature (opcional, default: 0)
# 0 = más determinístico, 1 = más creativo
OPENAI_TEMPERATURE=0

# 💾 Base de datos Prodigy
PRODIGY_DB=sqlite

# 🔢 Puerto del servidor
PRODIGY_PORT=8081
PRODIGY_PROXY_PORT=8082

# 🔀 Task Router Configuration (para Inter-Annotator Agreement)
# Cuántos anotadores deben ver cada tarea
# 1 = sin overlap (cada tarea la ve 1 persona)
# 2 = cada tarea la ven 2 personas (recomendado para IAA)
# 3+ = más overlap para datasets importantes
ANNOTATIONS_PER_TASK=2

# Habilitar/deshabilitar task routing (true/false)
ENABLE_TASK_ROUTING=true

# Sesiones de anotadores permitidas
PRODIGY_ALLOWED_SESSIONS="alice,bob,carlos,diana,elena"
