{"text": "Aguata pyae", "meta": {"spanish_text": "Camino rapido", "id": 1}}
{"text": "Rehecha pora", "meta": {"spanish_text": "Ves bien", "id": 2}}
{"text": "Oguata ape rupi", "meta": {"spanish_text": "Camina por el camino", "id": 3}}
{"text": "Ndaikatui aguata", "meta": {"spanish_text": "No puedo caminar", "id": 4}}
{"text": "Jaguereko nee pora", "meta": {"spanish_text": "Tenemos palabras bonitas", "id": 5}}
{"text": "Ahayhupa che sy", "meta": {"spanish_text": "Amo a mi madre", "id": 6}}
{"text": "Nderendui pa", "meta": {"spanish_text": "No escuchas?", "id": 7}}
{"text": "Ojejapo mitai", "meta": {"spanish_text": "Se hace el nino pequeno", "id": 8}}
{"text": "Namombae guasu", "meta": {"spanish_text": "Hacemos cosas grandes", "id": 9}}
{"text": "Peicha oguereko", "meta": {"spanish_text": "Asi lo tiene", "id": 10}}
